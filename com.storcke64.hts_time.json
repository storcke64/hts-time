/* * The Storcke Human Time System - By Antonio Storcke
 * Version: A40003.x - Theme Browser Fix
 * Fix: Explicitly linking control-panel-themes for the UI.
 */
{
    "app-id": "com.storcke64.hts_time",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Sdk",
    "command": "hts-time",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--device=dri",
        "--device=all",
        "--filesystem=xdg-videos:create",
        "--talk-name=org.freedesktop.portal.FileChooser",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.freedesktop.portal.Desktop",
        "--talk-name=org.freedesktop.portal.Documents",
        "--env=WEBKIT_FORCE_SANDBOX=0",
        "--env=GDK_BACKEND=wayland,x11",
        "--env=GTK_USE_PORTAL=1",
        "--env=GST_PLUGIN_PATH=/app/lib/ffmpeg/lib/gstreamer-1.0:/usr/lib/x86_64-linux-gnu/gstreamer-1.0:/usr/lib/gstreamer-1.0",
        "--env=LD_LIBRARY_PATH=/app/lib/ffmpeg/lib"
    ],
    "add-extensions": {
        "org.freedesktop.Platform.ffmpeg-full": {
            "directory": "lib/ffmpeg",
            "add-ld-path": "lib",
            "version": "24.08"
        }
    },
    "modules": [
        {
            "name": "ffmpeg-mount-point",
            "buildsystem": "simple",
            "build-commands": [ "mkdir -p /app/lib/ffmpeg" ]
        },
        {
            "name": "libqrencode",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_SHARED_LIBS=ON",
                "-DWITH_TOOLS=OFF",
                "-DWITH_TESTS=OFF",
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
            ],
            "sources": [ { "type": "archive", "url": "https://github.com/fukuchi/libqrencode/archive/refs/tags/v4.1.1.tar.gz", "sha256": "5385bc1b8c2f20f3b91d258bf8ccc8cf62023935df2d2676b5b67049f31a049c" } ]
        },
        {
            "name": "libmicrohttpd",
            "buildsystem": "autotools",
            "config-opts": [ "--disable-doc", "--disable-examples" ],
            "sources": [ { "type": "archive", "url": "https://ftp.gnu.org/gnu/libmicrohttpd/libmicrohttpd-0.9.77.tar.gz", "sha256": "9e7023a151120060d2806a6ea4c13ca9933ece4eacfc5c9464d20edddb76b0a0" } ]
        },
        {
            "name": "hts-time",
            "buildsystem": "meson",
            "config-opts": [ "--prefix=/app" ],
            "post-install": [
                "mkdir -p /app/bin/data",
                "ln -sf /app/share/hts-time/data/videos /app/bin/data/videos",
                "ln -sf /app/share/hts-time/data/pages /app/bin/data/pages",
                /* Fix: Link themes so the theme-browser.html can find them */
                "ln -sf /app/share/hts-time/data/control-panel-themes /app/bin/data/control-panel-themes"
            ],
            "sources": [ { "type": "dir", "path": "." } ]
        },
        {
            "name": "flathub-metadata",
            "buildsystem": "simple",
            "build-commands": [
                "install -D -m 644 com.storcke64.hts_time.metainfo.xml /app/share/metainfo/com.storcke64.hts_time.metainfo.xml",
                "install -D -m 644 com.storcke64.hts_time.desktop /app/share/applications/com.storcke64.hts_time.desktop"
            ],
            "sources": [ { "type": "dir", "path": "." } ]
        }
    ]
}